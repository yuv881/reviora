{{ 'reviora-widget.css' | asset_url | stylesheet_tag }}

<div class="reviora-trust-badge-block" style="text-align: {{ block.settings.alignment | default: 'center' }}; margin: {{ block.settings.margin_top | default: 12 }}px 0 {{ block.settings.margin_bottom | default: 12 }}px 0;">
  <div class="reviora-trust-badge-pill" style="display: inline-flex; align-items: center; gap: 8px; padding: 6px 14px; border-radius: 999px; background: {{ block.settings.bg_color | default: '#f8fafc' }}; border: 1px solid {{ block.settings.border_color | default: '#e2e8f0' }}; font-size: 13px; font-weight: 600; color: #0f172a;">
    <span style="color: {{ block.settings.star_color | default: '#FFB800' }}; font-size: 14px;">★ ★ ★ ★ ★</span>
    <span>{{ block.settings.badge_text | default: '4.9/5 from 1,280+ Verified Buyers' }}</span>
    <span style="color: #059669; display: inline-flex; align-items: center; gap: 3px; font-size: 11px;">
      <svg viewBox="0 0 24 24" style="width: 13px; height: 13px; fill: currentColor;"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"/></svg>
      100% Verified
    </span>
  </div>
</div>

{% schema %}
{
  "name": "Trust & Checkout Badge",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "4.9/5 from 1,280+ Verified Buyers"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Star Color",
      "default": "#FFB800"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#f8fafc"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border Color",
      "default": "#e2e8f0"
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "Top Margin",
      "default": 12
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "Bottom Margin",
      "default": 12
    }
  ]
}
{% endschema %}
