{{ 'reviora-widget.css' | asset_url | stylesheet_tag }}
<script src="{{ 'reviora-widget.js' | asset_url }}" defer="defer"></script>

<div class="reviora-qa-block" style="margin: {{ block.settings.margin_top | default: 32 }}px 0 {{ block.settings.margin_bottom | default: 32 }}px 0;">
  <reviora-qa-widget
    data-shop="{{ shop.myshopify_domain | default: shop.domain }}"
    data-product-id="{{ product.handle }}"
    data-heading="{{ block.settings.heading | default: 'Customer Questions & Answers' }}"
    data-accent-color="{{ block.settings.accent_color | default: '#0F172A' }}">
  </reviora-qa-widget>
</div>

{% schema %}
{
  "name": "Product Q&A",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Customer Questions & Answers"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#0F172A"
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Top Margin",
      "default": 32
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Bottom Margin",
      "default": 32
    }
  ]
}
{% endschema %}
