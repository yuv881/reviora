{{ 'reviora-widget.css' | asset_url | stylesheet_tag }}
<script src="{{ 'reviora-widget.js' | asset_url }}" defer="defer"></script>

<div class="page-width reviora-qa-section-wrapper" style="width: 100%; max-width: 1120px; margin: {{ block.settings.margin_top | default: 32 }}px auto {{ block.settings.margin_bottom | default: 32 }}px auto; padding: 0 16px; box-sizing: border-box;">
  {% assign current_product_id = product.handle | default: product.id %}
  {% if current_product_id == blank and template.name != 'product' %}
    {% assign current_product_id = 'demo-snowboard' %}
  {% endif %}

  <reviora-qa-widget
    data-shop="{{ shop.myshopify_domain | default: shop.domain }}"
    data-product-id="{{ current_product_id }}"
    data-product-handle="{{ product.handle | default: '' }}"
    data-product-title="{{ product.title | escape }}"
    data-heading="{{ block.settings.heading | default: 'Customer Questions & Answers' }}"
    data-accent-color="{{ block.settings.accent_color | default: '#0F172A' }}">
  </reviora-qa-widget>
</div>

{% schema %}
{
  "name": "Product Q&A",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Customer Questions & Answers"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#0F172A"
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Top Margin",
      "default": 32
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Bottom Margin",
      "default": 32
    }
  ]
}
{% endschema %}
