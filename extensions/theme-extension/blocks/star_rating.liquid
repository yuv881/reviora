{% assign avg_rating = block.settings.product.metafields.reviora.avg_rating.value | default: 5 %}
{% assign review_count = block.settings.product.metafields.reviora.review_count.value | default: 0 %}

<a href="#reviora-widget-container" class="reviora-star-badge" aria-label="Customer reviews: {{ avg_rating }} out of 5 stars{% if review_count > 0 %}, {{ review_count }} reviews{% endif %}" style="display: inline-flex; align-items: center; gap: 6px; font-size: 14px; color: {{ block.settings.colour }}; text-decoration: none; cursor: pointer;">
  <span style="letter-spacing: 1px;">
    {% render 'stars', rating: avg_rating %}
  </span>
  {% if review_count > 0 %}
    <span style="color: #4b5563; font-size: 13px;">({{ review_count }})</span>
  {% endif %}
</a>

{% schema %}
{
  "name": "Star Rating Badge",
  "target": "section",
  "settings": [
    { "type": "product", "id": "product", "label": "Product", "autofill": true },
    { "type": "color", "id": "colour", "label": "Star Colour", "default": "#FFB800" }
  ]
}
{% endschema %}

