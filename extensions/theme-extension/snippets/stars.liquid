{%- assign full_stars = rating | floor -%}
{%- assign empty_stars = 5 | minus: full_stars -%}

<span class="reviora-stars-svg-wrap" style="display:inline-flex;align-items:center;gap:2px;vertical-align:middle;">
  {%- for i in (1..full_stars) -%}
    <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
      <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
    </svg>
  {%- endfor -%}
  {%- for i in (1..empty_stars) -%}
    <svg width="15" height="15" viewBox="0 0 24 24" fill="#E2E8F0" xmlns="http://www.w3.org/2000/svg">
      <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
    </svg>
  {%- endfor -%}
</span>
